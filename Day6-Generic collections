#Generic Collections
#Queue - First in First out
# the first person to come in is the first to served.
using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
       
        Queue<string> queue = new Queue<string>();

        
        queue.Enqueue("Alice");
        queue.Enqueue("Bob");
        queue.Enqueue("Charlie");

      
        Console.WriteLine("Queue Elements:");

        foreach (string person in queue)
        {
            Console.WriteLine(person);
        }

        
        string servedPerson = queue.Dequeue();
        Console.WriteLine("\nServed Person: " + servedPerson);

        
        Console.WriteLine("Next Person: " + queue.Peek());

        
        Console.WriteLine("\nUpdated Queue:");

        foreach (string person in queue)
        {
            Console.WriteLine(person);
        }

        
        Console.WriteLine("\nTotal People in Queue: " + queue.Count);
    }
}

//Output:-
//Queue Elements:
//Alice
//Bob
//Charlie

//Served Person: Alice
//Next Person: Bob

//Updated Queue:
//Bob
//Charlie

//stack<T> - last in firstt out
using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
        
        Stack<string> stack = new Stack<string>();

        
        stack.Push("Book 1");
        stack.Push("Book 2");
        stack.Push("Book 3");

        
        Console.WriteLine("Stack Elements:");

        foreach (string book in stack)
        {
            Console.WriteLine(book);
        }

        
        string removedBook = stack.Pop();
        Console.WriteLine("\nRemoved: " + removedBook);

        
        Console.WriteLine("Top Element: " + stack.Peek());

        
        Console.WriteLine("\nUpdated Stack:");

        foreach (string book in stack)
        {
            Console.WriteLine(book);
        }

        
        Console.WriteLine("\nTotal Books: " + stack.Count);
    }
}
