//using System;

class Student
{
    private string name;
    private int rollNo;

    public string Name
    {
        get { return name; }
        set { name = value; }
    }

    public int RollNo
    {
        get { return rollNo; }
        set { rollNo = value; }
    }

    public void DisplayDetails()
    {
        Console.WriteLine($"Student Name: {Name}");
        Console.WriteLine($"Roll Number: {RollNo}");
    }
}

class Program
{
    static void Main()
    {
        Student s = new Student();

        s.Name = "Vaibhav Singh";
        s.RollNo = 101;

        s.DisplayDetails();
    }
}
